+// How many times cheaper per pixel a block must be than its parent before its
+// remaining partition trials are considered not worth running.
+#define RD_DENSITY_PRUNE_RATIO 2
+
+// Terminates the finer partition trials of a block that is already coding far
+// more efficiently than the region it was cut out of.
+//
+// PARTITION_NONE has just won for this block, and its RD cost per pixel is
+// known. Normalising by area makes that figure directly comparable with the
+// parent's, which covers a larger region: an even split of the parent's cost
+// would leave every child at the parent's density, so a child well below it sits
+// in a part of the frame that is intrinsically easier than its surroundings.
+// The absolute RD still available to a finer split of such a block is bounded by
+// its already small total cost, while each extra partition level keeps costing
+// signalling. Rectangular and extended trials are therefore dropped, and
+// PARTITION_SPLIT - by far the most valuable of the remaining options - is
+// deliberately left alone.
+//
+// Being a ratio between two RD costs, the test carries no absolute scale and so
+// adapts to content and quantiser on its own.
+static AVM_INLINE void prune_partitions_by_rd_density(
+    const PC_TREE *pc_tree, PartitionSearchState *part_search_state) {
+  if (part_search_state->forced_partition != PARTITION_INVALID) return;
+  if (pc_tree->parent == NULL) return;
+
+  const BLOCK_SIZE bsize = part_search_state->part_blk_params.bsize;
+  if (block_size_wide[bsize] <= 8 || block_size_high[bsize] <= 8) return;
+
+  const int64_t this_density = pc_tree->none_rd_per_pixel;
+  const int64_t parent_density = pc_tree->parent->none_rd_per_pixel;
+  if (this_density == INT64_MAX || parent_density == INT64_MAX) return;
+  if (this_density * RD_DENSITY_PRUNE_RATIO >= parent_density) return;
+
+  part_search_state->do_rectangular_split = false;
+  part_search_state->prune_partition[PARTITION_HORZ] = true;
+  part_search_state->prune_partition[PARTITION_VERT] = true;
+  part_search_state->prune_partition[PARTITION_HORZ_3] = true;
+  part_search_state->prune_partition[PARTITION_VERT_3] = true;
+  part_search_state->prune_partition[PARTITION_HORZ_4A] = true;
+  part_search_state->prune_partition[PARTITION_HORZ_4B] = true;
+  part_search_state->prune_partition[PARTITION_VERT_4A] = true;
+  part_search_state->prune_partition[PARTITION_VERT_4B] = true;
+}
