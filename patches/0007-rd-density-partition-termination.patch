@@ -3558,6 +3603,8 @@ static void prune_partitions_after_none(AV2_COMP *const cpi, MACROBLOCK *x,
 
   (void)sms_tree;
 
+  prune_partitions_by_rd_density(pc_tree, part_search_state);
+
   if (!frame_is_intra_only(cm) && part_search_state->do_rectangular_split &&
       !xd->lossless[xd->mi[0]->segment_id] && ctx_none->skippable) {
     const int use_ml_based_breakout =
@@ -3885,6 +3932,13 @@ static void none_partition_search(
     }
     *part_none_rd = this_rdc->rdcost;
 
+    // Record how expensive this block is per pixel when coded whole, so that
+    // descendants can compare themselves against it. See
