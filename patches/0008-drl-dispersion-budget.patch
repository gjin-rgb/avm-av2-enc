--- a/av2/encoder/rdopt.c
+++ b/av2/encoder/rdopt.c
@@ -4797,6 +4797,11 @@ typedef struct {
   inter_mode_info (
       *mode_info)[BAWP_OPTION_CNT][NUM_MV_PRECISIONS][MAX_REF_MV_SQUARE];
   int_mv (*save_mv)[NUM_MV_PRECISIONS][MAX_REF_MV_SQUARE][2];
+
+  // Best RD produced by the DRL index currently being evaluated, tracked
+  // independently of best_rd so that the DRL loop can measure how much the
+  // choice of reference MV actually matters for this block.
+  int64_t *drl_best_rd;
 } PredictorSearchState;
 /*!\endcond */
 
@@ -4828,6 +4833,7 @@ static AVM_INLINE void init_predictor_search_state(
   search_state->best_ref_mv_idx = best_ref_mv_idx;
   search_state->mode_info = mode_info;
   search_state->save_mv = save_mv;
+  search_state->drl_best_rd = NULL;
 }
 
 // Updates the best search state if the current RD cost is better than the
@@ -4838,6 +4844,12 @@ static AVM_INLINE void update_predictor_search_state(
     const RD_STATS *rd_stats_y, const RD_STATS *rd_stats_uv,
     const TxfmSearchInfo *txfm_info, int num_planes, int tmp_rate_mv,
     int rate2_nocoeff, motion_mode_candidate *motion_mode_cand) {
+  // Note the candidate against the DRL index being evaluated before the global
+  // best filters it out: the DRL stopping rule needs the RD every index can
