@@ -1756,7 +1756,7 @@ int64_t av2_rd_pick_intra_sby_mode(const AV2_COMP *const cpi, ThreadData *td,
   mbmi->mapped_intra_mode[PLANE_TYPE_Y][mbmi->txb_idx] = DC_PRED;
 
   MB_MODE_INFO best_mbmi = *mbmi;
-  av2_zero(x->winner_mode_stats);
