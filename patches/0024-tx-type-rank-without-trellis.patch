+  //
+  // -DAVM_TX_RANK_TRELLIS=1 restores the original behaviour.
+#ifndef AVM_TX_RANK_TRELLIS
+#define AVM_TX_RANK_TRELLIS 0
+#endif
+  av2_setup_quant(tx_size, AVM_TX_RANK_TRELLIS, AV2_XFORM_QUANT_B,
