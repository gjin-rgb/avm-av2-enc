-  av2_setup_quant(tx_size, 1, AV2_XFORM_QUANT_B, cpi->oxcf.q_cfg.quant_b_adapt,
-                  &quant_param);
+  // Second transform-type ranking loop; see the comment on the first for why
+  // the trellis is skipped here. Same switch governs both.
+  av2_setup_quant(tx_size, AVM_TX_RANK_TRELLIS, AV2_XFORM_QUANT_B,
+                  cpi->oxcf.q_cfg.quant_b_adapt, &quant_param);
 
   for (int idx = 0; idx < TX_TYPES; idx++) {
     tx_type = idx;
