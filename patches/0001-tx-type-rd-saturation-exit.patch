+        // Saturation based termination of the transform type search.
+        //
+        // The candidates are visited in prior-ranked order, so the running
+        // best RD forms a decreasing, rapidly flattening sequence. Stop as
+        // soon as that sequence looks converged instead of exhausting the
+        // ranked list. The tolerated run of non-improving candidates is
+        // derived from two observations made during the search itself:
+        //   - a marginal last win (< ~1.6% of best_rd) means the sequence has
+        //     already flattened out,
+        //   - a very compact winning residual (eob <= max_eob / 8) means the
+        //     energy is already concentrated and the remaining kernels have
+        //     little left to gain.
+        // The starting budget follows the preset aggressiveness that
+        // search_level already encodes, so conservative presets keep
+        // searching longer before declaring saturation.
+        if (num_rd_evals >= 3) {
+          int stale_budget = search_level ? 3 : 5;
+          if (last_rd_gain != INT64_MAX && best_rd != INT64_MAX &&
+              last_rd_gain < (best_rd >> 6)) {
+            --stale_budget;
+          }
+          if (best_eob > 0 && (int)best_eob * 8 <= max_eob) --stale_budget;
+          if (stale_budget < 1) stale_budget = 1;
+          if (stale_run >= stale_budget) {
+            skip_idx = true;
+            break;
+          }
+        }
