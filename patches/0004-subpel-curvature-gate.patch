+// Curvature gate for the sub-pixel refinement ladder.
+//
+// Close to its minimum the prediction error behaves like a locally quadratic
+// surface E(d) ~ E0 + c*d^2, so a refinement level with step h/2 can recover at
+// most about a quarter of what the level with step h just recovered. Once the
+// gain produced by the level that finished is a negligible fraction of the
+// error that is left, every finer level is negligible as well and only costs
+// further upsampled predictions. A level that did not move the MV at all
+// (gain == 0) proves the centre is already a local minimum at that scale and is
+// terminated by the very same test.
+#define SUBPEL_FLAT_SURFACE_SHIFT 8
+static INLINE int subpel_refinement_saturated(unsigned int err_before,
+                                              unsigned int err_after) {
+  assert(err_after <= err_before);
+  const uint64_t gain = (uint64_t)(err_before - err_after);
+  return (gain << SUBPEL_FLAT_SURFACE_SHIFT) <= (uint64_t)err_after;
+}
