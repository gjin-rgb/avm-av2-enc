+/*! Number of full pixel motion search results memoised per block. */
+#define FULLPEL_MEMO_ENTRIES 8
+
+/*! \brief Complete description of one full pixel motion search problem.
+ *
+ * Every input that can change the outcome of av2_full_pixel_search() while the
+ * encoder stays on the same block is captured here, so that two searches with
+ * equal keys are guaranteed to produce equal results. The source and reference
+ * buffer pointers stand in for the block position and the reference frame, and
+ * the search range limits stand in for the block geometry.
+ */
+typedef struct {
+  const uint16_t *src_buf;  /*!< Source block pointer. */
+  const uint16_t *ref_buf;  /*!< Reference block pointer. */
+  int src_stride;           /*!< Source stride. */
+  int ref_stride;           /*!< Reference stride. */
+  FullMvLimits mv_limits;   /*!< Full pel search limits of the block. */
+  int32_t ref_mv;           /*!< Predictor the MV rate is measured against. */
+  int32_t start_mv;         /*!< Full pel starting point of the search. */
+  int32_t step_param;       /*!< Coarsest step of the step search. */
+  int32_t opfl_iterations;  /*!< Optical flow refinement iterations. */
+  uint8_t bsize;            /*!< Block size. */
+  uint8_t precision;        /*!< MV precision the search runs at. */
+  uint8_t motion_mode;      /*!< Motion mode driving the search. */
+  uint8_t adaptive_mvd;     /*!< Adaptive MVD resolution flag. */
+} FullpelSearchKey;
+
+/*! \brief One memoised full pixel motion search result. */
+typedef struct {
+  FullpelSearchKey key;      /*!< Search problem this result belongs to. */
+  FULLPEL_MV best_mv;        /*!< Winning full pel MV. */
+  FULLPEL_MV second_best_mv; /*!< Runner up, seeds the sub pel search. */
+  int best_err;              /*!< Error of the winning MV. */
+  int cost_list[5];          /*!< Neighbourhood costs for the sub pel search. */
+  int valid;                 /*!< Whether this slot holds a result. */
+} FullpelSearchMemoEntry;
+
+/*! \brief Small direct mapped memo of the block's full pixel motion searches.
+ *
+ * A single inter mode is evaluated repeatedly for the same block: across DRL
+ * indices, MV precisions, BAWP on/off and refined-MV on/off. Many of those
+ * iterations pose the very same full pixel search problem, which is by far the
+ * most expensive part of evaluating them. Remembering the results within the
+ * block turns those repeats into lookups. The stamp fields bound the memo to
+ * one block so stale entries can never be hit.
+ */
+typedef struct {
+  int mi_row;      /*!< Row of the block the memo belongs to. */
+  int mi_col;      /*!< Column of the block the memo belongs to. */
+  int bsize;       /*!< Size of the block the memo belongs to. */
+  uint32_t stamp;  /*!< FULLPEL_MEMO_STAMP once the fields above are valid. */
+  FullpelSearchMemoEntry entries[FULLPEL_MEMO_ENTRIES]; /*!< Memo slots. */
+} FullpelSearchMemo;
+
+/*! Marks a FullpelSearchMemo whose block stamp has been initialised. */
+#define FULLPEL_MEMO_STAMP 0x9e3779b9u
