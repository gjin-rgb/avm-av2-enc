 // Allow more mesh searches for screen content type on the ARF.
+// FNV-1a over the raw bytes of a search key. The key is always memset before
+// being filled in, so padding bytes are deterministic.
+static INLINE uint32_t fullpel_key_hash(const FullpelSearchKey *key) {
+  const uint8_t *const bytes = (const uint8_t *)key;
+  uint32_t hash = 2166136261u;
+  for (size_t i = 0; i < sizeof(*key); ++i) {
+    hash ^= bytes[i];
+    hash *= 16777619u;
+  }
+  return hash;
+}
+
+// Finds the memo slot for a full pixel search problem on the current block.
+//
+// The memo is rebound to the block on first use, so entries recorded while
+// encoding a different block, a different segment or a different frame can
+// never be consulted. Within a block a slot is only reported as a hit when the
+// whole key matches, which makes a hit an exact substitute for re-running the
+// search rather than an approximation of it. On a miss the returned slot is the
+// one the caller should fill in once it has the result.
+static FullpelSearchMemoEntry *fullpel_memo_slot(MACROBLOCK *x, int mi_row,
+                                                 int mi_col, BLOCK_SIZE bsize,
+                                                 const FullpelSearchKey *key,
+                                                 int *hit) {
+  FullpelSearchMemo *const memo = &x->fullpel_memo;
+  if (memo->stamp != FULLPEL_MEMO_STAMP || memo->mi_row != mi_row ||
+      memo->mi_col != mi_col || memo->bsize != (int)bsize) {
+    memset(memo->entries, 0, sizeof(memo->entries));
+    memo->mi_row = mi_row;
+    memo->mi_col = mi_col;
+    memo->bsize = (int)bsize;
+    memo->stamp = FULLPEL_MEMO_STAMP;
+  }
+  FullpelSearchMemoEntry *const entry =
+      &memo->entries[fullpel_key_hash(key) & (FULLPEL_MEMO_ENTRIES - 1)];
+  *hit = entry->valid && !memcmp(&entry->key, key, sizeof(*key));
+  return entry;
+}
