+// A PICK_MODE_CONTEXT owns a fixed set of small per-4x4-block arrays whose
+// sizes are known the moment the block size is known, and which are never
+// resized afterwards. The partition search however allocates and destroys
+// contexts constantly: every rectangular, split and extended partition trial
+// tears down a subtree and builds a fresh one. Handing each of those arrays its
+// own heap block therefore costs 17 malloc/free pairs per context and scatters
+// data that is always walked together across the heap.
+//
+// Instead, lay the context and all of its arrays out in a single arena so that
+// one allocation serves the whole context, one free releases it, and the
+// metadata is contiguous in memory.
+#define PMC_ARENA_ALIGN 32
+
+// Reserves `bytes` at the end of the arena described by `size` and returns the
+// offset of the reservation. Every reservation is padded so that the next one
+// stays PMC_ARENA_ALIGN aligned, which preserves the alignment the individual
+// avm_memalign() calls used to guarantee.
+static INLINE size_t pmc_arena_reserve(size_t *size, size_t bytes) {
+  const size_t offset = *size;
+  *size = offset + ((bytes + (PMC_ARENA_ALIGN - 1)) & ~(size_t)(PMC_ARENA_ALIGN - 1));
+  return offset;
+}
